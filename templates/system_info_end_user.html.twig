{% set textarea_id = 'af_sysinfo_' ~ random() %}

<div data-af-sysinfo>
    <textarea
        id="{{ textarea_id }}"
        class="form-control font-monospace"
        rows="8"
        name="{{ question.getEndUserInputName() }}"
        aria-label="{{ question.fields['name'] }}"
        aria-describedby="{{ textarea_id }}_help"
        data-af-sysinfo-input
        data-af-questions-id="{{ question.fields['id'] }}"
    ></textarea>
    <div id="{{ textarea_id }}_help" class="form-text">{{ help }}</div>
    <div class="mt-2" data-af-sysinfo-preview aria-live="polite"></div>
</div>

<script type="module">
    import { AfSystemInfoQuestion } from '/plugins/advancedforms/js/modules/AfSystemInfoQuestion.js';
    new AfSystemInfoQuestion(document.getElementById('{{ textarea_id }}'));
</script>
