{% set container_id = 'actor-notification-config-' ~ random() %}
{% set helper = __('Actors found only by disabled sources are added without email followup. Sources added to the actors fields are listed once the destination is saved.', 'advancedforms') %}
<div id="{{ container_id }}" data-testid="actor-notification-config">
    {# The field label is rendered by GLPI core, which offers no way to add a
       helper next to it: the script below moves this icon into the label. #}
    <span class="form-help ms-1" tabindex="0" aria-label="{{ helper }}"
          data-testid="actor-notification-helper"
          data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-placement="top"
          data-bs-title="{{ helper }}">?</span>
    <script>
        (() => {
            const container = document.getElementById('{{ container_id|e('js') }}');
            const helper = container.querySelector('[data-testid="actor-notification-helper"]');
            const label = container
                .closest('[data-glpi-itildestination-field]')
                ?.querySelector(':scope > div > label.form-label');
            if (label !== null && label !== undefined) {
                label.append(helper);
            }
            if (typeof initTooltips === 'function') {
                initTooltips(helper.parentElement);
            }
        })();
    </script>

    {% set disabled = options.disabled|default(false) %}
    {% for role in roles %}
        <fieldset class="mb-2" data-testid="actor-notification-role">
            <legend class="fs-5 fw-bold mb-1">{{ role.label }}</legend>
            {% for row in role.rows %}
                {# The checkbox value overrides the hidden one: an unchecked toggle
                   submits "1", meaning the source is disabled. A disabled field
                   submits nothing. #}
                <label class="form-check form-switch mb-1">
                    <input name="{{ row.input_name }}" type="hidden" value="1" {{ disabled ? 'disabled' : '' }}>
                    <input
                        name="{{ row.input_name }}"
                        class="form-check-input"
                        type="checkbox"
                        value="0"
                        {{ row.enabled ? 'checked' : '' }}
                        {{ disabled ? 'disabled' : '' }}
                    >
                    <span class="form-check-label">
                        {{ row.label }}
                        {% if row.strategy_label is not null %}
                            <span class="text-secondary">({{ row.strategy_label }})</span>
                        {% endif %}
                    </span>
                </label>
            {% endfor %}
        </fieldset>
    {% else %}
        <span class="text-secondary">
            {{ __('No user or supplier source is configured in the actors fields.', 'advancedforms') }}
        </span>
    {% endfor %}
</div>
