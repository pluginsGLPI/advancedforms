{# @var GlpiPlugin\Advancedforms\Model\Destination\Email\EmailDestination item #}
{# @var Glpi\Form\Form form #}
{# @var Glpi\Form\Destination\FormDestination destination #}
{# @var array config #}
{# @var bool can_update #}
{# @var string|null recipients_warning #}

{# The fields are rendered by the same macro as the core ITIL destinations #}
{% import 'pages/admin/form/form_destination_commonitil_config.html.twig' as itil_config %}

<div class="overflow-x-hidden row d-flex mx-n4 border-top">
    <div class="col-12 col-lg-8 order-last order-lg-first px-4 py-2 d-flex flex-column">
        {# Form rows: label above the field, hairline between the fields #}
        <div class="py-3 border-bottom">
            <span class="form-label text-secondary">{{ __('Subject', 'advancedforms') }}</span>
            {{ itil_config.field_config_section(item, destination, title_field, form, config, false) }}
        </div>
        {# The label shares the line of the "Auto config" switch of the core field #}
        <div class="py-3 advancedforms-email-body">
            <span class="form-label text-secondary">{{ __('Body', 'advancedforms') }}</span>
            {{ itil_config.field_config_section(item, destination, content_field, form, config, false) }}
        </div>
    </div>
    <div class="col-12 col-lg-4 mt-0 p-0 rounded-0 card-footer border-start border-top-0">
        <div class="d-flex flex-column space-y-3 p-3">
            {# Same alert as the warnings of the core destinations tab #}
            {% if recipients_warning is not null %}
                <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <span>{{ recipients_warning }}</span>
                </div>
            {% endif %}
            {{ itil_config.field_config_section(item, destination, recipients_field, form, config) }}
            {{ itil_config.field_config_section(item, destination, addresses_field, form, config) }}
        </div>
    </div>
    <div class="itil-footer card-footer p-0 border-top p-2 ps-4 pe-4">
        {% if can_update %}
            {{ include('pages/admin/form/form_destination_actions.html.twig', {
                form: form,
                destination: destination
            }, with_context = false) }}
        {% endif %}
    </div>
</div>
